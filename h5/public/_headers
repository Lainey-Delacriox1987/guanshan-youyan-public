# HTML and application files revalidate after a release. Artwork names contain content hashes.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/mist/*.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/mist/*.avif
  Cache-Control: public, max-age=31536000, immutable

/assets/walk/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/walk/*.avif
  Cache-Control: public, max-age=31536000, immutable
